# ==========================================================
# Blockchain E-Voting System - Environment Configuration
# ==========================================================

# Django Security Settings
DJANGO_SECRET_KEY=django-insecure-voting-system-p256-blockchain-secret-key-2026
DJANGO_DEBUG=True

# Mode: Set to True for effortless offline demo & evaluation (auto-generates OTPs and keys)
DEMO_MODE=True

# Blockchain Parameters
TRANSACTIONS_PER_BLOCK=1
PUZZLE=000

# Email SMTP Credentials (Optional - only required if DEMO_MODE=False)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_ADDRESS=
EMAIL_PASSWORD=

